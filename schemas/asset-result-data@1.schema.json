{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Asset command result data",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "assetId",
        "name",
        "sourceCopy",
        "sourceHash",
        "cacheKey",
        "cachePath",
        "animationChannelCount"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sourceCopy": {
          "type": "string",
          "pattern": "^assets/"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cacheKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cachePath": {
          "type": "string",
          "pattern": "^\\.engine/cache/"
        },
        "animationChannelCount": {
          "type": "integer",
          "minimum": 0
        },
        "dryRun": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "cache": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "ready",
                "unavailable"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets"
      ],
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "assetId",
              "name",
              "sourceCopy",
              "sourceHash",
              "cacheKey",
              "cachePath",
              "animationChannelCount"
            ],
            "properties": {
              "assetId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sourceCopy": {
                "type": "string",
                "pattern": "^assets/"
              },
              "sourceHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "cacheKey": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "cachePath": {
                "type": "string",
                "pattern": "^\\.engine/cache/"
              },
              "animationChannelCount": {
                "type": "integer",
                "minimum": 0
              },
              "dryRun": {
                "type": "boolean"
              },
              "valid": {
                "type": "boolean"
              },
              "cache": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "ready",
                      "unavailable"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
