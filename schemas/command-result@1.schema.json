{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engine.local/schemas/command-result@1.schema.json",
  "title": "engine command result",
  "type": "object",
  "required": [
    "status",
    "data",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "data": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^E_[A-Z_]+$"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "hint": {
          "type": "string"
        }
      }
    }
  }
}
