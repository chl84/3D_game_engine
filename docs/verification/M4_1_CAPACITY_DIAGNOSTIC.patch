+std::size_t diagnostic_rss_bytes() {
+    std::ifstream input("/proc/self/statm");
+    std::size_t pages = 0;
+    std::size_t resident = 0;
+    require(static_cast<bool>(input >> pages >> resident), "cannot read diagnostic RSS");
+    const auto page_size = ::sysconf(_SC_PAGESIZE);
+    require(page_size > 0, "cannot read diagnostic page size");
+    return resident * static_cast<std::size_t>(page_size);
+}
