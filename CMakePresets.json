{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "displayName": "Linux Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "displayName": "Linux Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "ci-linux-gcc",
      "inherits": "base",
      "displayName": "CI Linux GCC",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "ENGINE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-linux-gcc14",
      "inherits": "base",
      "displayName": "CI Linux GCC 14",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++-14",
        "CMAKE_C_COMPILER": "gcc-14",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "ENGINE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-linux-clang",
      "inherits": "base",
      "displayName": "CI Linux Clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "ENGINE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-asan",
      "inherits": "linux-debug",
      "displayName": "Linux ASan + UBSan",
      "cacheVariables": {
        "ENGINE_SANITIZE_ADDRESS": "ON",
        "ENGINE_SANITIZE_UNDEFINED": "ON",
        "ENGINE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "linux-debug",
      "displayName": "Linux TSan",
      "cacheVariables": {
        "ENGINE_SANITIZE_THREAD": "ON",
        "ENGINE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "base",
      "displayName": "Windows Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "displayName": "Windows Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "ci-windows",
      "inherits": "windows-debug",
      "displayName": "CI Windows MSVC",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "ENGINE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-fuzz",
      "inherits": "base",
      "displayName": "Clang libFuzzer + ASan/UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "ENGINE_BUILD_FUZZERS": "ON",
        "ENGINE_SANITIZE_ADDRESS": "ON",
        "ENGINE_SANITIZE_UNDEFINED": "ON",
        "ENGINE_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link",
        "CMAKE_C_FLAGS": "-fsanitize=fuzzer-no-link"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "ci-linux-gcc",
      "configurePreset": "ci-linux-gcc"
    },
    {
      "name": "ci-linux-gcc14",
      "configurePreset": "ci-linux-gcc14"
    },
    {
      "name": "ci-linux-clang",
      "configurePreset": "ci-linux-clang"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    },
    {
      "name": "linux-fuzz",
      "configurePreset": "linux-fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-linux-gcc",
      "configurePreset": "ci-linux-gcc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-linux-gcc14",
      "configurePreset": "ci-linux-gcc14",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-linux-clang",
      "configurePreset": "ci-linux-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-asan-lavapipe",
      "displayName": "Local Mesa lavapipe leak-check policy",
      "inherits": "linux-asan",
      "environment": {
        "VK_LOADER_DISABLE_DYNAMIC_LIBRARY_UNLOADING": "1",
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/sanitizers/mesa-lavapipe.supp:print_suppressions=1"
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
